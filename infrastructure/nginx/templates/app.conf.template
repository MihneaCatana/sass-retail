upstream web {
  server web:80;
}

upstream api {
  server api:3000;
}

upstream keycloak {
  server keycloak:8080;
}

server {
  listen 80;

  # Keycloak (IAM) — served on the same origin so the OIDC issuer is
  # origin-relative and identical in every environment.
  location /realms/ {
    proxy_pass http://keycloak;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    # The PUBLIC port (nginx listens on 80 inside the container).
    proxy_set_header X-Forwarded-Port ${NGINX_PUBLIC_PORT};
  }

  # API routes
  location /api/ {
    proxy_pass http://api;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Everything else -> Angular static build
  location / {
    proxy_pass http://web;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
  }
}
