# ---- Postgres ----
POSTGRES_USER=retail
POSTGRES_PASSWORD=retail-dev-password
POSTGRES_DB=retail
# Role passwords (created by infrastructure/postgres/init/02-roles.sh)
POSTGRES_APP_PASSWORD=retail-app-dev-password
POSTGRES_MIGRATE_PASSWORD=retail-migrate-dev-password
# Host port for postgres (5432 is often taken by other projects)
POSTGRES_HOST_PORT=5433
# Used by apps running on the host (docker uses `postgres`)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ---- API ----
NODE_ENV=development
API_PORT=3000
CORS_ORIGIN=http://localhost:4200,http://localhost:8082
JWT_ISSUER_URL=http://localhost:8082/realms/retail
JWT_JWKS_URL=http://localhost:8081/realms/retail/protocol/openid-connect/certs
JWT_AUDIENCE=retail-api

# ---- Keycloak ----
# Bootstrap admin for the keycloak container itself (not used by the API)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-password
KEYCLOAK_PORT=8081
# Used by the API's onboarding module (scoped service client, INFRA-011)
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_ONBOARDING_CLIENT_ID=retail-onboarding
KEYCLOAK_ONBOARDING_CLIENT_SECRET=retail-onboarding-dev-secret

# ---- Nginx ----
NGINX_PORT=8082

