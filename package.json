{
  "name": "sass-retail",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:up": "docker compose -f infrastructure/docker-compose.yml up -d --build",
    "dev:down": "docker compose -f infrastructure/docker-compose.yml down",
    "dev:logs": "docker compose -f infrastructure/docker-compose.yml logs -f --tail=100",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d postgres keycloak nginx",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml stop api web",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.19.0"
  }
}

